# Database (PostgreSQL — Neon, Prisma Postgres, Supabase, Vercel Postgres…)
# Requis pour le build (`prisma generate`) et le runtime DB.
DATABASE_URL="postgresql://user:password@host:5432/dicha_studio?schema=public&sslmode=require"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@dichastudio.com"
ADMIN_PASSWORD="change-me"

# Storage (Vercel Blob / S3 compatible)
STORAGE_ACCESS_KEY=""
STORAGE_SECRET=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_PUBLIC_URL=""
BLOB_READ_WRITE_TOKEN=""

# Email
EMAIL_SERVER=""
EMAIL_FROM="contact@dichastudio.com"

# Site (URL publique Vercel ou domaine custom)
NEXT_PUBLIC_SITE_URL="https://votre-projet.vercel.app"
NEXT_PUBLIC_ACCENT_COLOR="#03A7A8"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
